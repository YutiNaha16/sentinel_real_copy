# SENTINEL deployment config — copy this file to ".env" and fill in real values.
# Docker Compose reads ".env" automatically. NEVER commit the real ".env".

# --- Database (a strong password is required) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=sentinel

# --- Security ---
# A long random string. Generate one, e.g.: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_long_random_secret
JWT_EXPIRES_IN=12h

# --- Public address ---
# The URL users reach the app on. MUST be correct so the "Acknowledge" links in
# alerts work. In production this is your domain, e.g. https://sentinel.sodexo.com
PUBLIC_BASE_URL=http://localhost:8080

# Which port the web app is published on (behind your reverse proxy in production).
WEB_PORT=8080

# --- Notification channel ---
# "mock"     = no real messages (safe default, in-app inbox only)
# "whatsapp" = real WhatsApp via Twilio (fill the three TWILIO_ values below)
# "http"     = email via an HTTPS email API
EMAIL_PROVIDER=mock

# Your WhatsApp/Twilio credentials (only needed when EMAIL_PROVIDER=whatsapp).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional prefix on every alert subject, e.g. "[TEST]" during trials. Leave blank in production.
EMAIL_SUBJECT_PREFIX=
