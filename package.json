{
  "name": "sodexo-crisis",
  "version": "0.1.0",
  "private": true,
  "description": "SENTINEL Crisis — call-tree escalation & acknowledgement system (Sodexo IT/Cyber pilot)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "api:dev": "npm run start:dev --workspace @sodexo-crisis/api",
    "api:migrate": "npm run migrate --workspace @sodexo-crisis/api",
    "api:seed": "npm run seed --workspace @sodexo-crisis/api",
    "web:dev": "npm run dev --workspace @sodexo-crisis/web"
  },
  "engines": {
    "node": ">=20"
  }
}
