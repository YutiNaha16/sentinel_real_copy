# Copy to .env and adjust. NEVER commit the real .env.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5433/sentinel_dev?schema=public"

# Auth (dev only — use strong secrets in any shared/hosted environment)
JWT_SECRET="change-me-dev-only-secret"
JWT_EXPIRES_IN="12h"

# Seed test-user password (dev only)
SEED_PASSWORD="Passw0rd!"

PORT=3000

# Public base URL used in email Acknowledge links
PUBLIC_BASE_URL="http://localhost:3000"

# Email delivery. Default "mock" = in-app inbox only (nothing sent).
# For real sending use an HTTPS email API (e.g. Resend) — NOT SMTP (blocked on the pilot network).
EMAIL_PROVIDER="mock"
# EMAIL_PROVIDER="http"
# EMAIL_API_URL="https://api.resend.com/emails"
# EMAIL_API_KEY="re_xxx"
# EMAIL_FROM="SENTINEL <onboarding@resend.dev>"
